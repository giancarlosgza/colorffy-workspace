{
  "name": "@colorffy/ui",
  "version": "2.5.0",
  "description": "A modern Vue 3 component library built with TypeScript and Colorffy CSS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs"
    },
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "pnpm run build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "npm run build-storybook && touch ./storybook-static/.nojekyll && gh-pages -d storybook-static -t"
  },
  "peerDependencies": {
    "@vueuse/components": "^14.0.0",
    "@vueuse/core": "^14.0.0",
    "floating-vue": "^5.2.0",
    "nuxt": "^3.0.0 || ^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@colorffy/css": "workspace:*",
    "@nuxt/kit": "^4.4.8",
    "@nuxt/schema": "^4.4.8",
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-links": "^10.3.1",
    "@storybook/addon-vitest": "^10.3.1",
    "@storybook/vue3": "^10.3.1",
    "@storybook/vue3-vite": "^10.3.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vueuse/core": "^14.3.0",
    "eslint-plugin-storybook": "10.2.1",
    "gh-pages": "^6.3.0",
    "nuxt": "^4.4.8",
    "playwright": "^1.61.1",
    "storybook": "^10.3.1",
    "touch-cli": "^0.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.7"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "components",
    "ui",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/giancarlosgza/colorffy-workspace.git",
    "directory": "packages/colorffy-ui"
  },
  "homepage": "https://github.com/giancarlosgza/colorffy-workspace#readme",
  "bugs": {
    "url": "https://github.com/giancarlosgza/colorffy-workspace/issues"
  },
  "author": "Giancarlos Garza",
  "license": "MIT"
}
