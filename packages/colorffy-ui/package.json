{
  "name": "@colorffy/ui",
  "version": "1.4.1",
  "description": "A modern Vue 3 component library built with TypeScript and Colorffy CSS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "pnpm run build",
    "fix:imports": "node scripts/fix-imports.js",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "npm run build-storybook && touch ./storybook-static/.nojekyll && gh-pages -d storybook-static -t"
  },
  "peerDependencies": {
    "@vueuse/components": "^14.0.0",
    "floating-vue": "^5.2.0",
    "nuxt": "^4.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@colorffy/css": "workspace:*",
    "@nuxt/kit": "^4.2.1",
    "@nuxt/schema": "^4.2.1",
    "@storybook/addon-a11y": "^10.2.1",
    "@storybook/addon-docs": "^10.2.1",
    "@storybook/addon-links": "^10.2.1",
    "@storybook/addon-vitest": "^10.2.1",
    "@storybook/vue3": "^10.2.1",
    "@storybook/vue3-vite": "^10.2.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vueuse/core": "^14.0.0",
    "eslint-plugin-storybook": "10.2.1",
    "gh-pages": "^6.3.0",
    "nuxt": "^4.2.0",
    "playwright": "^1.58.0",
    "storybook": "^10.2.1",
    "touch-cli": "^0.0.1",
    "typescript": "^5.4.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.0",
    "vue-router": "^4.6.3",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "components",
    "ui",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/giancarlosgza/colorffy-workspace.git",
    "directory": "packages/colorffy-ui"
  },
  "homepage": "https://github.com/giancarlosgza/colorffy-workspace#readme",
  "bugs": {
    "url": "https://github.com/giancarlosgza/colorffy-workspace/issues"
  },
  "author": "Giancarlos Garza",
  "license": "MIT"
}
