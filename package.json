{
  "name": "colorffy-workspace",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ui": "eslint packages/colorffy-ui",
    "lint:playground": "eslint playground",
    "pnpm:install": "pnpm install",
    "pnpm:prune": "pnpm prune",
    "pnpm:build": "pnpm run build -r",
    "docs:dev": "pnpm --filter colorffy-docs dev",
    "docs:build": "pnpm --filter colorffy-docs build",
    "docs:generate": "pnpm --filter colorffy-docs generate",
    "docs:preview": "pnpm --filter colorffy-docs preview",
    "docs:deploy": "pnpm --filter colorffy-docs generate && npx wrangler@latest pages deploy docs/.output/public --project-name=colorffy-ui-docs"
  },
  "keywords": [],
  "author": "Giancarlos Garza",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@antfu/eslint-config": "9.1.0",
    "eslint": "10.6.0",
    "typescript": "6.0.3",
    "wrangler": "4.110.0"
  }
}
